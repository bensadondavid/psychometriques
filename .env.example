# Neon — connexion directe utilisée par Prisma Migrate
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Neon — connexion poolée utilisée par l’application
DATABASE_POOLER_URL="postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require"

# Better Auth
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Connexion Google
GOOGLE_CLIENT_ID="replace-with-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"

# Emails de vérification et de réinitialisation
RESEND_API_KEY="re_replace-with-resend-api-key"
RESEND_MAIL="Psychométriques <noreply@example.com>"
