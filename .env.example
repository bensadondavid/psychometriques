# Application and database
DATABASE_URL=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Email and Google authentication
RESEND_API_KEY=
EMAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional bot protection (both values are required to enable Turnstile)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional Stripe integration (secret + webhook enable customer management)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Adding a monthly price enables the "premium" subscription plan.
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PREMIUM_ANNUAL_PRICE_ID=
