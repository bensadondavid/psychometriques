generator client {
  provider = "prisma-client"
  output   = "../lib/database/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  COMING_SOON
}

enum QuestionStatus {
  DRAFT
  VALIDATED
  PUBLISHED
  ARCHIVED
}

enum QuestionDomain {
  VERBAL
  QUANTITATIVE
}

enum QuestionType {
  ANALOGY
  VERBAL_REASONING
  PASSAGE_COMPREHENSION
  QUANTITATIVE
}

enum ExerciseKind {
  DISCOVERY
  PREPARED
  LESSON_PRACTICE
}

enum AttemptMode {
  LEARNING
  EXAM
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(user)
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  passkeys      Passkey[]
  programAccesses ProgramAccess[]
  attempts      Attempt[]
  studyGoal     StudyGoal?

  @@unique([email])
  @@map("user")
}

model StudyGoal {
  id                 String         @id @default(cuid())
  userId             String         @unique
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  examSlug           String
  examDate           String?
  objective          String?
  sessionsPerWeek    Int            @default(3)
  sessionMinutes     Int            @default(30)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  sessions           StudySession[]

  @@map("study_goal")
}

model StudySession {
  id          String     @id @default(cuid())
  goalId      String
  goal        StudyGoal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  scheduledOn String
  title       String
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([goalId, scheduledOn])
  @@map("study_session")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuer                String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model Program {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String
  description String?
  status      ContentStatus     @default(COMING_SOON)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  courses     Course[]
  chapters    QuestionChapter[]
  passages    Passage[]
  figures     QuestionFigure[]
  accesses    ProgramAccess[]
  exercises   Exercise[]

  @@index([status, sortOrder])
  @@map("program")
}

model Course {
  id          String        @id @default(cuid())
  programId   String
  program     Program       @relation(fields: [programId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  slug        String
  name        String
  description String?
  status      ContentStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  lessons     Lesson[]
  chapters    QuestionChapter[]

  @@unique([programId, slug])
  @@unique([id, programId])
  @@index([programId, status, sortOrder])
  @@map("course")
}

model Lesson {
  id        String        @id @default(cuid())
  programId String
  courseId  String
  course    Course        @relation(fields: [courseId, programId], references: [id, programId], onDelete: Restrict, onUpdate: NoAction)
  sourceId  String?       @unique
  slug      String
  title     String
  content   String?
  status    ContentStatus @default(DRAFT)
  contentVersion Int      @default(1)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  exercises Exercise[]
  chapters  LessonChapter[]

  @@unique([courseId, slug])
  @@unique([id, courseId])
  @@unique([id, programId])
  @@index([courseId, status, sortOrder])
  @@map("lesson")
}

// Effective access, created only after a subscription has been verified server-side.
// Billing records and provider events remain separate from this authorization state.
model ProgramAccess {
  id                      String   @id @default(cuid())
  userId                  String
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  programId               String
  program                 Program  @relation(fields: [programId], references: [id], onDelete: Restrict)
  verifiedSubscriptionKey String   @unique
  startsAt                DateTime
  endsAt                  DateTime
  revokedAt               DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([userId, programId])
  @@index([programId, endsAt])
  @@map("program_access")
}

model Exercise {
  id           String             @id @default(cuid())
  programId    String
  program      Program            @relation(fields: [programId], references: [id], onDelete: Restrict)
  lessonId     String?
  lesson       Lesson?            @relation(fields: [lessonId, programId], references: [id, programId], onDelete: Restrict, onUpdate: NoAction)
  chapterId    String?
  chapter      QuestionChapter?  @relation(fields: [chapterId, programId], references: [id, programId], onDelete: Restrict, onUpdate: NoAction)
  kind         ExerciseKind       @default(PREPARED)
  slug         String
  title        String
  instructions String?
  status       ContentStatus      @default(DRAFT)
  sortOrder    Int                @default(0)
  timeLimitSeconds Int?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  questions    ExerciseQuestion[]
  attempts     Attempt[]

  @@unique([programId, slug])
  @@unique([id, programId])
  @@index([programId, kind, status, sortOrder])
  @@index([chapterId, programId])
  @@index([lessonId])
  @@map("exercise")
}

model LessonChapter {
  lessonId String
  chapterId String
  courseId String
  lesson   Lesson @relation(fields: [lessonId, courseId], references: [id, courseId], onDelete: Cascade, onUpdate: NoAction)
  chapter  QuestionChapter @relation(fields: [chapterId, courseId], references: [id, courseId], onDelete: Cascade, onUpdate: NoAction)

  @@id([lessonId, chapterId])
  @@index([chapterId, courseId])
  @@map("lesson_chapter")
}

model QuestionChapter {
  id         String         @id @default(cuid())
  programId  String
  program    Program        @relation(fields: [programId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  courseId   String?
  course     Course?        @relation(fields: [courseId, programId], references: [id, programId], onDelete: Restrict, onUpdate: NoAction)
  domain     QuestionDomain
  externalId Int
  slug       String
  name       String
  sortOrder  Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  questions  Question[]
  lessons    LessonChapter[]
  exercises  Exercise[]

  @@unique([programId, domain, externalId])
  @@unique([programId, domain, slug])
  @@unique([id, programId, domain])
  @@unique([id, programId])
  @@unique([id, courseId])
  @@index([programId, domain, sortOrder])
  @@index([courseId, sortOrder])
  @@map("question_chapter")
}

model Passage {
  id              String        @id @default(cuid())
  programId       String
  program         Program       @relation(fields: [programId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  externalId      String
  title           String
  theme           String
  text            String
  wordCount       Int
  estimatedLines  Int
  language        String        @default("fr")
  status          ContentStatus @default(DRAFT)
  sourceStatus    ContentStatus @default(DRAFT)
  editorialReviewedAt DateTime?
  sourceCreatedAt DateTime
  sourceUpdatedAt DateTime
  sourceFile      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  questions       Question[]

  @@unique([programId, externalId])
  @@unique([id, programId])
  @@index([programId, status])
  @@index([programId, theme])
  @@map("passage")
}

model Question {
  id              String             @id @default(cuid())
  programId       String
  chapterId       String
  chapter         QuestionChapter    @relation(fields: [chapterId, programId, domain], references: [id, programId, domain], onDelete: Restrict, onUpdate: NoAction)
  passageId       String?
  passage         Passage?           @relation(fields: [passageId, programId], references: [id, programId], onDelete: Restrict, onUpdate: NoAction)
  externalId      String
  domain          QuestionDomain
  type            QuestionType
  subTheme        String
  difficulty      Int
  difficultyLabel String
  statement       String
  explanation     String
  language        String             @default("fr")
  status          QuestionStatus     @default(DRAFT)
  sourceStatus    QuestionStatus     @default(DRAFT)
  editorialReviewedAt DateTime?
  imagePath       String?
  imageAlt        String?
  sourceCreatedAt DateTime
  sourceUpdatedAt DateTime
  sourceFile      String?
  version         Int                @default(1)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  options         QuestionOption[]
  exercises       ExerciseQuestion[]
  attemptQuestions AttemptQuestion[]

  @@unique([programId, externalId])
  @@unique([id, programId])
  @@index([programId, domain, status])
  @@index([chapterId, difficulty])
  @@index([passageId])
  @@index([subTheme])
  @@map("question")
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  position   Int
  text       String
  isCorrect  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([questionId, position])
  @@index([questionId, isCorrect])
  @@map("question_option")
}

model QuestionFigure {
  id        String   @id @default(cuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  path      String
  fileName  String
  svg       String
  byteSize  Int
  checksum  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([programId, path])
  @@index([programId, fileName])
  @@index([checksum])
  @@map("question_figure")
}

model ExerciseQuestion {
  id         String   @id @default(cuid())
  exerciseId String
  programId  String
  exercise   Exercise @relation(fields: [exerciseId, programId], references: [id, programId], onDelete: Cascade, onUpdate: NoAction)
  questionId String
  question   Question @relation(fields: [questionId, programId], references: [id, programId], onDelete: Restrict, onUpdate: NoAction)
  position   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([exerciseId, questionId])
  @@unique([exerciseId, position])
  @@index([questionId])
  @@index([questionId, programId])
  @@map("exercise_question")
}

model Attempt {
  id               String        @id @default(cuid())
  userId           String?
  user             User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId       String
  exercise         Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  mode             AttemptMode
  status           AttemptStatus @default(IN_PROGRESS)
  claimTokenHash   String?       @unique
  claimExpiresAt   DateTime?
  startedAt        DateTime      @default(now())
  deadlineAt       DateTime?
  completedAt      DateTime?
  updatedAt        DateTime      @updatedAt
  questions        AttemptQuestion[]

  @@index([userId, startedAt])
  @@index([exerciseId, status])
  @@index([claimExpiresAt])
  @@map("attempt")
}

model AttemptQuestion {
  id              String   @id @default(cuid())
  attemptId       String
  attempt         Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId      String
  question        Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  position        Int
  questionVersion Int
  snapshot        Json
  answer          AttemptAnswer?

  @@unique([attemptId, position])
  @@unique([attemptId, questionId])
  @@index([questionId])
  @@map("attempt_question")
}

model AttemptAnswer {
  id                String          @id @default(cuid())
  attemptQuestionId String          @unique
  attemptQuestion   AttemptQuestion @relation(fields: [attemptQuestionId], references: [id], onDelete: Cascade)
  value             Json
  isCorrect         Boolean?
  answeredAt        DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@map("attempt_answer")
}
